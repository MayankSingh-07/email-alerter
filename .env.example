# Gmail Credentials (Use Google Account App Passwords)
COLLEGE_GMAIL_USER=your_college_email@college.edu
COLLEGE_GMAIL_PASSWORD=your_16_char_app_password
PERSONAL_GMAIL_USER=your_personal_email@gmail.com
PERSONAL_GMAIL_PASSWORD=your_16_char_app_password

# Groq API Key (https://console.groq.com)
GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# CallMeBot WhatsApp Gateway (https://www.callmebot.com/blog/free-api-whatsapp-messages/)
CALLMEBOT_PHONE=+919876543210
CALLMEBOT_API_KEY=your_callmebot_api_key_here

# Polling Interval in seconds (default: 300)
POLL_INTERVAL_SECONDS=300

# SQLite Database Path (default: data/alerts.db)
DB_PATH=data/alerts.db
